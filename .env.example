# PlankBot Configuration — copy to .env and fill in your values

BOT_TOKEN=your-telegram-bot-token

# API server URL (where api.py runs)
API_BASE_URL=http://127.0.0.1:5000

# Telegram group/channel IDs (negative numbers for groups/channels)
REQUIRED_CHAT_ID=
REQUIRED_CHANNEL_ID=
CHAT_INVITE_LINK=
CHANNEL_INVITE_LINK=

# Hit notification channels
HIT_PUBLIC_CHAT_ID=
HIT_PRIVATE_CHANNEL_ID=

# Owner Telegram user IDs (JSON array)
OWNER_IDS=[]

# File paths
DATABASE_PATH=plankbot.db
PROXY_FILE=proxies.txt
SHOPIFY_SITES_FILE=sites.txt

# Redis (Upstash) — TLS connection string. Leave blank to disable Redis.
#   rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=
BIN_CACHE_TTL=86400
